{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for ThePrivator's typed command bridge and fixed Python sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/theprivator-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
